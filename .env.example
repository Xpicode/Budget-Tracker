# Copy this file to .env and fill in real values. .env is git-ignored.
# Use letters, digits, - and _ only in the password (it is pasted into a URL).
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://budget:change-me@localhost:5434/budget
PORT=4000
JWT_SECRET=change-me-too

# Production only: the token Cloudflare shows when you create the tunnel.
TUNNEL_TOKEN=
